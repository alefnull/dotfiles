# [volume]
# enabled = true
# position = "right"
# interval = 2
# step = 1
# min_width = 50
# justify = "center"
# class = ""
#
# [brightness]
# enabled = true
# position = "right"
# interval = 5
# step = 5
# min_width = 50
# justify = "center"
# class = ""
#
# [battery]
# enabled = true
# position = "right"
# interval = 10
# adapter = "BAT0"
# warning = 20
# critical = 10
# full_at = 98

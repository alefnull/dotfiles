# min_width = 60
# justify = "center"
# class = ""
#
# [power_profiles]
# enabled = true
# position = "right"
# min_width = 80
# justify = "center"
# class = ""
#
# [power]
# enabled = true
# position = "right"
# min_width = 50
# justify = "center"
# class = ""

[[group]]
enabled = true
position = "right"
spacing = 0
homogeneous = false
container_margin = 0
orientation = "horizontal"
modules = ["network", "cpu", "memory", "volume", "brightness"]

[[group]]
enabled = true
name = "powermodules"
position = "right"
css_prefix = "powermodules"
spacing = 0
homogeneous = false
container_margin = 0
orientation = "horizontal"
modules = ["battery", "power_profiles", "power"]

# =============================================================================
# SCRIPT MODULE (uncomment to use)
# =============================================================================


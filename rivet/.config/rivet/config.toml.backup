# =============================================================================
# RIVET CONFIGURATION
# =============================================================================

[bar]
position = "top"
margin_top = 0
margin_bottom = 0
margin_left = 0
margin_right = 0
width = 0
exclusive = true
layer = "top"
opacity = 1.0
spacing = 0
wallust_colors = "~/.cache/wallust/colors.json"

[workspaces]
enabled = true
position = "left"
justify = "center"
show = "names"
range = ""
show_all = false

[window]
enabled = true
position = "left"
justify = "center"
max_length = 30
scroll = "hover"
scroll_speed = 300
show_icon = true
truncation_mode = "end"
truncation_symbol = "..."

[clock]
enabled = true
position = "center"
justify = "center"
format = "%-I:%M %p / %A, %B %-d"
interval = 1
timezone = ""

# [cpu]
# enabled = true
# position = "left"
# interval = 2
# warning = 80
# critical = 95
# show_per_core = true

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
      "separator": ".........",     // Separator between keys and values
      "brightColor": true,
      "key": {
          "width": 12,       // Aligns keys to this width
          "type": "both"   	 // string, icon, both, or none
      },
      "bar": {
          "width": 10,       // Width of percentage bars
          "char": {
              "elapsed": "■",
              "total": "-"
          }
      }
  },

  "logo": {
      "type": "auto",        // Logo type: auto, builtin, small, file, etc.
      "source": "arch2",      // Built-in logo name or file path
      // "width": 65,           // Width in characters (for image logos)
      // "height": 35,          // Height in characters (for image logos)
      "padding": {
          "top": 0,          // Top padding
          "left": 0,         // Left padding
          "right": 1         // Right padding
      }
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "host",
      "key": " HOST"
    },
		{
			"type": "os",
			"key": " OSYS"
		},
		{
			"type": "kernel",
			"key": " KRNL"
		},
    {
      "type": "bootmgr",
      "key": " BOOT"
    },
		{
			"type": "shell",
			"key": " SHLL"
		},
		{
			"type": "display",
      "key": " DISP"
		},
		{
			"type": "wm",
			"key": " WMGR"
		},
		{
			"type": "terminal",
      "key": " TERM"
		},
		{
			"type": "cpu",
			"format": "{1}",
			"key": " CPU"
		},
		{
			"type": "memory",
			"key": " MEM"
		},
		{
			"type": "gpu",
			"format": "{2} ({6})",
			"key": " GPU{index}"
		},
    {
      "type": "battery",
      "key": " BTRY"
    },
    "separator",
		{
			"type": "disk",
			"key": " {mountpoint}"
		},
    "break",
    "colors"
  ]
}
